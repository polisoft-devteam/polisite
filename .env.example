# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored and must never be committed.
#
# Where to find each value in the Supabase dashboard:
#   Project Settings → Database → Connection string
#   Project Settings → API Keys

# --- Database (Drizzle) ---
# All reads and writes of our own tables go through these, never through the
# Supabase client. See CLAUDE.md.

# Used by the app at runtime. Use the POOLED connection (Transaction mode, port 6543) —
# serverless functions open many short-lived connections and would otherwise exhaust
# the database's connection limit.
DATABASE_URL=

# Used by migrations only. Use the DIRECT connection (port 5432); schema changes do
# not work through the transaction pooler.
DIRECT_URL=

# --- Supabase (auth and file storage only) ---

# Project URL and publishable key (starts with "sb_publishable_").
# Public by design — the NEXT_PUBLIC_ prefix ships these to the browser on purpose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (starts with "sb_secret_"). Bypasses every database restriction.
# Server-side only: never add a NEXT_PUBLIC_ prefix, never import into a client component.
# Older projects call this the service_role key.
SUPABASE_SECRET_KEY=

# --- Discord notifications ---
# Server-side only. Never add a NEXT_PUBLIC_ prefix.

# Discord → Server Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL.
# Holding this URL lets someone post to that one channel and nothing else. Keep it out of
# git and out of client code; if it leaks, delete the webhook and make a new one.
DISCORD_GENERAL_CHANNEL_WEBHOOK_URL=

# ID of the role to ping on announcements — currently "Poli".
# Enable Developer Mode (Settings → Advanced), then right-click the role → Copy Role ID.
# Named by purpose, not by label, so renaming the role in Discord changes nothing here.
DISCORD_MEMBER_ROLE_ID=

# Absolute URL of the site, used for links in Discord messages. No trailing slash.
# Optional: unset, the app falls back to VERCEL_URL in production and localhost in dev.
# Set it once you have a real domain, so links use that rather than the deployment URL.
NEXT_PUBLIC_SITE_URL=

# Shared secret for the scheduled reminder job. Vercel Cron sends it as
# "Authorization: Bearer <value>". Generate one with: openssl rand -hex 32
# The route refuses to run at all if this is unset, so it can never be called openly.
CRON_SECRET=

# Your Discord user ID, so membership requests ping you directly rather than the whole
# role. Enable Developer Mode, then right-click your name → Copy User ID.
# Left blank, the message still posts but mentions nobody.
DISCORD_ADMIN_USER_ID=

# Webhook for a private channel only the admin reads — membership requests go here rather
# than to general. A Discord webhook is tied to one channel, so this needs its own.
# Left blank, those messages fall back to the general channel.
DISCORD_BOT_CHANNEL_WEBHOOK_URL=

# --- Shared links ---
# Shown on the archive page to active members only, so these never reach a guest's browser.
# Server-side only: a "anyone with the link" share URL is a key, not an address.

# Discord server invite. Server Settings → Invites, or right-click the server → Invite People.
DISCORD_INVITE_URL=


# Google Drive folder for documents and originals.
GOOGLE_DRIVE_URL=

# The repository. Private, so this only helps signed-in members with access.
GITHUB_REPO_URL=
