# Copy this file to .env.local and fill in the values from your Supabase project.
# .env.local is gitignored and must never be committed.
#
# Where to find each value in the Supabase dashboard:
#   Project Settings → Database → Connection string
#   Project Settings → API

# Postgres connection used by the app at runtime.
# Use the POOLED connection (Transaction mode, port 6543) — serverless functions open
# many short-lived connections and would otherwise exhaust the database.
DATABASE_URL=

# Postgres connection used by migrations only.
# Use the DIRECT connection (port 5432). Migrations run schema changes, which the
# transaction pooler does not support.
DIRECT_URL=

# Supabase project URL and public key. Safe to expose to the browser — the NEXT_PUBLIC_
# prefix means Next.js ships these to the client on purpose.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses all database restrictions.
# Never prefix this with NEXT_PUBLIC_ and never import it into a client component.
SUPABASE_SERVICE_ROLE_KEY=
